# claude-delegate configuration.
#
# Copy to <your-repo>/.claude/delegate.local.env (or anywhere, then export
# DELEGATE_CONFIG=/path/to/file). Keep the copy out of version control.
#
# This file holds NO secrets and never should: model/provider credentials stay in the
# backend's own config (e.g. ~/.codex/config.toml), which this skill never reads or copies.

# Which adapter in backends/ to use (backends/<name>.sh).
DELEGATE_BACKEND="codex"

# Absolute path of the main checkout. Defaults to the main worktree of the git repo
# the command is run from.
DELEGATE_MAIN_REPO="/path/to/your/repo"

# Where worktrees are created, relative to DELEGATE_MAIN_REPO. Must be gitignored.
DELEGATE_WORKTREE_ROOT=".claude/worktrees"

# MCP server names (as keyed in the backend's config) to disable for every delegated
# run, e.g. issue trackers or error monitoring the headless agent must never touch.
DELEGATE_DISABLE_MCP="issue-tracker error-monitoring"

# Provisioning hooks from provision.d/ (without .sh), run in order inside a new worktree.
DELEGATE_PROVISION_HOOKS=""

# For provision.d/link-local-config.sh: gitignored per-checkout files to symlink from
# the main checkout into the worktree (space-separated, repo-relative).
DELEGATE_LINK_FILES=""

# For provision.d/php-composer-classmap.sh: vendor/ entries that must be real copies
# instead of symlinks (anything that resolves paths relative to its own __DIR__).
DELEGATE_REAL_COPY_VENDOR="composer bin"

# For provision.d/node-modules-symlink.sh: directories (repo-relative) to symlink from
# the main checkout, e.g. "node_modules" or "web/node_modules web/bundles".
DELEGATE_LINK_DIRS="node_modules"

# Project profile: gates to re-run and project-specific prompt additions.
# Relative paths resolve against the skill directory.
DELEGATE_PROFILE="profiles/example-php-symfony.md"

# Extra arguments passed verbatim to the backend CLI (e.g. -m <model>).
DELEGATE_EXTRA_ARGS=""

# Where prompts, pid files and run logs are kept (outside the worktree so they never
# show up in its diff).
DELEGATE_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-delegate"

# --- Backend-specific -------------------------------------------------------------
# codex: approval mode flags. --approve-for-me implies the workspace-write sandbox;
# never combine it with --sandbox, never use --dangerously-bypass-approvals-and-sandbox.
DELEGATE_CODEX_APPROVAL_ARGS="--approve-for-me"

# kilo: persona agent to run (created with `kilo agent create`).
DELEGATE_KILO_AGENT="agents/tdd-subtask"
